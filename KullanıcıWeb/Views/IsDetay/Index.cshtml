<script>
    // Arama özellikli dropdown fonksiyonu (DOM güvenli hale getirildi)
    function setupSearchableDropdown(inputId, menuId, hiddenId) {
        var input = document.getElementById(inputId);
        var menu = document.getElementById(menuId);
        var hidden = document.getElementById(hiddenId);
        if (!input || !menu) return;

        var items = menu.getElementsByClassName('option-item');

        input.addEventListener('click', function() {
            var bootstrapDropdown = new bootstrap.Dropdown(input);
            bootstrapDropdown.show();
        });

        input.addEventListener('input', function() {
            var filter = input.value.toLowerCase();
            var bootstrapDropdown = new bootstrap.Dropdown(input);
            bootstrapDropdown.show();

            for (var i = 0; i < items.length; i++) {
                var text = items[i].textContent || items[i].innerText;
                if (text.toLowerCase().indexOf(filter) > -1) {
                    items[i].style.display = "";
                } else {
                    items[i].style.display = "none";
                }
            }
        });

        menu.addEventListener('click', function(e) {
            if (e.target && e.target.classList.contains('option-item')) {
                var selectedText = e.target.getAttribute('data-text');
                var selectedValue = e.target.getAttribute('data-value');

                input.value = selectedText;
                hidden.value = selectedValue;
            }
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        // Dropdown kurulumları DOM yüklendiği an güvenli şekilde tetikleniyor
        setupSearchableDropdown('projectSearch', 'projectMenu', 'gizliProjectId');
        setupSearchableDropdown('organizationSearch', 'organizationMenu', 'gizliOrganization');
        setupSearchableDropdown('assignedUserSearch', 'assignedUserMenu', 'gizliAssignedUserId');

        var textarea = document.getElementById("mesajIcerik");
        var fileInput = document.getElementById("gorselFile");
        var btnTetikle = document.getElementById("btnDosyaSecTetikle");
        var onizlemeListesi = document.getElementById("onizlemeListesiKonteyner");
        var form = document.getElementById("yorumForm");
        var mesajKutusu = document.getElementById("mesajKutusu");

        // Seçilen veya yapıştırılan tüm dosyaları hafızada tutacak dinamik liste
        var yuklenenDosyalar = [];

        // Artı butonuna tıklandığında gizli dosya inputunu tetikler
        if (btnTetikle && fileInput) {
            btnTetikle.addEventListener("click", function () {
                fileInput.click();
            });
        }

        // Sayfayı otomatik en alta kaydıran yardımcı fonksiyon
        function scrollEnAltaKaydir() {
            if (mesajKutusu) {
                mesajKutusu.scrollTop = mesajKutusu.scrollHeight;
            }
        }

        if (mesajKutusu) {
            scrollEnAltaKaydir();
            setTimeout(scrollEnAltaKaydir, 50);
            setTimeout(scrollEnAltaKaydir, 250);

            var iceridekiGorseller = mesajKutusu.querySelectorAll("img");
            var yuklenenGorselSayisi = 0;
            
            if (iceridekiGorseller.length > 0) {
                iceridekiGorseller.forEach(function(img) {
                    img.addEventListener("load", function() {
                        yuklenenGorselSayisi++;
                        if (yuklenenGorselSayisi === iceridekiGorseller.length) {
                            scrollEnAltaKaydir();
                        }
                    });
                });
            }
        }

        if (!textarea || !fileInput) return;

        // Gelişmiş Dosya ve Resim Yapıştırma (Ctrl+V) Desteği
        textarea.addEventListener("paste", function (e) {
            var clipboardData = e.clipboardData || window.clipboardData;
            if (!clipboardData) return;

            var items = clipboardData.items;
            var dosyaBulundu = false;

            for (var i = 0; i < items.length; i++) {
                if (items[i].type.indexOf("image") !== -1) {
                    var file = items[i].getAsFile();
                    var pastedFile = new File([file], "pasted_image_" + Date.now() + ".png", { type: "image/png" });
                    yuklenenDosyalar.push(pastedFile);
                    dosyaBulundu = true;
                }
                else if (items[i].kind === "file") {
                    var file = items[i].getAsFile();
                    if (file) {
                        yuklenenDosyalar.push(file);
                        dosyaBulundu = true;
                    }
                }
            }

            if (dosyaBulundu) {
                e.preventDefault();
                arayuzOnizlemeGuncelle();
            }
        });

        // Dosya inputundan çoklu seçim yapıldığında tetiklenir
        fileInput.addEventListener("change", function () {
            if (fileInput.files) {
                for (var i = 0; i < fileInput.files.length; i++) {
                    yuklenenDosyalar.push(fileInput.files[i]);
                }
                arayuzOnizlemeGuncelle();
            }
        });

        // Hafızadaki dosyaları eşzamanlı olarak render eden fonksiyon
        function arayuzOnizlemeGuncelle() {
            if (!onizlemeListesi) return;
            onizlemeListesi.innerHTML = "";

            if (yuklenenDosyalar.length === 0) {
                onizlemeListesi.classList.add("d-none");
                onizlemeListesi.classList.remove("d-flex");
                fileInput.value = "";
                return;
            }

            onizlemeListesi.classList.remove("d-none");
            onizlemeListesi.classList.add("d-flex");

            yuklenenDosyalar.forEach(function (file, index) {
                var dosyaAdi = file.name;
                var uzanti = dosyaAdi.substring(dosyaAdi.lastIndexOf('.')).toLowerCase();
                var resimUzantilari = ['.jpg', '.jpeg', '.png', '.gif', '.webp'];

                var kartId = "kart_" + index;
                var kartHtml = `
                    <div id="${kartId}" class="position-relative" style="width: 76px; height: 76px;">
                        <img id="img_${kartId}" src="" class="d-none rounded-3 border" style="width: 100%; height: 100%; object-fit: cover;" />
                        <div id="doc_${kartId}" class="d-none flex-column justify-content-between p-2 rounded-3 bg-secondary text-white w-100 h-100" style="opacity: 0.9;">
                            <span class="fw-bold text-uppercase opacity-75" style="font-size: 9px; letter-spacing: 0.5px;">${uzanti.replace('.', '').toUpperCase()}</span>
                            <span class="text-wrap lh-sm fw-semibold w-100 text-start" style="font-size: 10px; max-height: 40px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; text-overflow: ellipsis; word-break: break-all;">${dosyaAdi.substring(0, dosyaAdi.lastIndexOf('.'))}</span>
                        </div>
                        <button type="button" class="btn btn-danger btn-sm position-absolute d-flex align-items-center justify-content-center border-white shadow" style="top: -6px; right: -6px; width: 18px; height: 18px; padding: 0; border-radius: 50%; z-index: 5;" title="Kaldır">
                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="currentColor" class="bi bi-x-lg text-white" viewBox="0 0 16 16">
                              <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854z"/>
                            </svg>
                        </button>
                    </div>
                `;

                onizlemeListesi.insertAdjacentHTML('beforeend', kartHtml);

                var elImg = document.getElementById("img_" + kartId);
                var elDoc = document.getElementById("doc_" + kartId);
                var elBtnKaldir = document.getElementById(kartId).querySelector("button");

                if (resimUzantilari.includes(uzanti) || file.type.indexOf("image") !== -1) {
                    if(elDoc) elDoc.classList.add("d-none");
                    if(elImg) elImg.classList.remove("d-none");
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        if(elImg) elImg.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                } else {
                    if(elImg) elImg.classList.add("d-none");
                    if(elDoc) {
                        elDoc.classList.remove("d-none");
                        elDoc.classList.add("d-flex");
                    }
                }

                elBtnKaldir.addEventListener("click", function () {
                    yuklenenDosyalar.splice(index, 1);
                    arayuzOnizlemeGuncelle();
                });
            });
        }

        // Form post edilirken hafızadaki dosyaları HTML inputuna bağlar
        if (form) {
            form.addEventListener("submit", function (e) {
                var textValue = textarea.value.trim();

                if (textValue === "" && yuklenenDosyalar.length === 0) {
                    alert("Lütfen göndermeden önce bir mesaj yazın veya bir dosya ekleyin!");
                    e.preventDefault();
                    return;
                }

                var dataTransfer = new DataTransfer();
                yuklenenDosyalar.forEach(function (file) {
                    dataTransfer.items.add(file);
                });
                fileInput.files = dataTransfer.files;
            });
        }

        // ==========================================
        // DİNAMİK MESAJ VE LOG FİLTRELEME MOTORU
        // ==========================================
        var filtreButonlari = document.querySelectorAll("[data-filtre]");

        // 🎯 DÜZELTME: filterButonlari typo'su giderildi, filtreButonlari olarak senkronize edildi.
        filtreButonlari.forEach(function (btn) {
            btn.addEventListener("click", function () {
                filtreButonlari.forEach(function (b) {
                    b.classList.remove("active");
                    b.style.backgroundColor = "transparent";
                    b.style.color = "#fff";
                });
                btn.classList.add("active");
                btn.style.backgroundColor = "#fff";
                btn.style.color = "#000";

                var secilenFiltre = btn.getAttribute("data-filtre");
                var mesajKartlari = document.querySelectorAll(".mesaj-karti");

                mesajKartlari.forEach(function (kart) {
                    var hareketTipi = kart.getAttribute("data-hareket");
                    var dosyaDurumu = kart.getAttribute("data-dosya");

                    if (secilenFiltre === "tum") {
                        kart.style.setProperty("display", "", "important");
                        if (hareketTipi === "SYSTEM_LOG") {
                            kart.style.setProperty("display", "flex", "important");
                        }
                    }
                    else if (secilenFiltre === "dosya") {
                        if (hareketTipi === "USER_MESSAGE" && dosyaDurumu === "VAR") {
                            kart.style.setProperty("display", "block", "important");
                        } else {
                            kart.style.setProperty("display", "none", "important");
                        }
                    }
                    else if (secilenFiltre === "sistem") {
                        if (hareketTipi === "SYSTEM_LOG") {
                            kart.style.setProperty("display", "flex", "important");
                        } else {
                            kart.style.setProperty("display", "none", "important");
                        }
                    }
                });

                scrollEnAltaKaydir();
            });
        });

    }); // DOMContentLoaded Kapanışı
</script>