@using Microsoft.AspNetCore.Http

<div class="container mt-5">
    
    @*PERSONEL & YETKİ MODÜLÜ Sadece admin görebilir *@
        @if (Context.Session.GetInt32("RoleId") == KullanıcıWeb.Models.Roller.Admin)    {
        <div class="card shadow-sm border-0 bg-light p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="text-primary font-weight-bold mb-1">
                        👥 Personel & Yetki Modülü
                    </h4>
                    <p class="text-muted small mb-0">
                        Personel yönetimi
                    </p>
                </div>
                <a asp-controller="Kullanici" asp-action="Index" class="btn btn-primary btn-lg shadow-sm font-weight-bold">
                    <i class="bi bi-people-fill"></i> Yönetim Paneline Giriş Yap ➡️
                </a>
            </div>
        </div>

        @* PLANLAMA PANELİ Sadece admin görebilir *@
        <div class="card shadow-sm border-0 bg-light p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="text-warning font-weight-bold mb-1" style="color: #e0a800 !important;">
                        📅 Planlama Paneli
                    </h4>
                    <p class="text-muted small mb-0">
                        İşlerin yönetim süreçleri
                    </p>
                </div>
                <a asp-controller="Planlama" asp-action="Index" class="btn btn-warning btn-lg shadow-sm font-weight-bold text-dark">
                    <i class="bi bi-calendar-check-fill"></i> Planlama Modülüne Git ➡️
                </a>
            </div>
        </div>
    }
    

   @*İŞ TAKİP PANELİ Kartı herkes görür düzenleme kısmını sadece admin görür *@
    <div class="card shadow-sm border-0 bg-light p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h4 class="text-success font-weight-bold mb-1">
                    🏢 Vizyoneks İş Takip Paneli
                </h4>
                <p class="text-muted small mb-0">
                    Görev Havuzu ve İş Atamaları
                </p>
            </div>
                 
            <div class="d-flex align-items-center gap-2">


                @*  sadece admini göreceği panel butonları *@
                @if (Context.Session.GetInt32("RoleId") == 6)
                {
                    <a asp-controller="Proje" asp-action="Index" class="btn btn-sm btn-secondary text-white shadow-sm font-weight-bold py-2 px-3">
                        <i class="bi bi-folder-fill"></i> Projeleri Yönet
                    </a>
                    <a asp-controller="Organizasyon" asp-action="Index" class="btn btn-sm btn-secondary text-white shadow-sm font-weight-bold py-2 px-3">
                        <i class="bi bi-building-fill"></i> Organizasyonları Yönet
                    </a>
                    <a asp-controller="Kategori" asp-action="Index" class="btn btn-sm btn-secondary text-white shadow-sm font-weight-bold py-2 px-3">
                        <i class="bi bi-tags-fill"></i> Kategorileri Yönet
                    </a>
                }
                
                
                <a asp-controller="IsTakip" asp-action="Index" class="btn btn-success btn-lg shadow-sm font-weight-bold">
                    📊 İş Takip Modülüne Git ➡️
                </a>
            </div>
        </div>
    </div>

</div>